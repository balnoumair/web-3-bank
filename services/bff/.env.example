# GraphQL server port
PORT=4000

# JWT signing secret — required unless BFF_DEV_MODE=1
JWT_SECRET=

# Allow dev JWT fallback and legacy authenticate(credentialId) without assertion
# BFF_DEV_MODE=1

# WebAuthn relying party — must match the bank-client origin
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Default chain id embedded in JWT when client omits chainId
DEFAULT_CHAIN_ID=1337

# gRPC upstreams
USER_SERVICE_ADDR=localhost:50051
TREASURY_SERVICE_ADDR=localhost:50052
