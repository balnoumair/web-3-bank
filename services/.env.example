# Services — shared environment variables
# Copy to .env and fill in real values before running docker compose

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Each service connects with its own role and can only access its own schema.
# Get from: Supabase Dashboard > Project Settings > Database > Connection string
# Use port 5432 (Session mode), NOT port 6543 (pooled).
# search_path is enforced in code via after_connect — no URL suffix needed.
USER_SERVICE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
TREASURY_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
