# Treasury Service — environment variables
# Copy to .env and fill in values before running

# ── RPC endpoints (JSON map: chain_id → URL) ─────────────────────────────────
# Format: {"1":"https://mainnet.example.com","84532":"https://base-sepolia.example.com"}
RPC_URLS=

# ── Contract addresses (JSON map: chain_id → checksummed address) ─────────────
# Bank contract address per chain
# Format: {"84532":"0xYourContractAddress"}
CONTRACT_ADDRESSES=

# ── RouteReceiver address (Base Sepolia) ──────────────────────────────────────
ROUTE_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Relayer key ───────────────────────────────────────────────────────────────
# Path to a plaintext file containing the relayer's hex-encoded private key
RELAYER_KEY_PATH=

# ── Pauser key (optional) ─────────────────────────────────────────────────────
# Path to a plaintext file containing the pauser's hex-encoded private key.
# The account must hold PAUSER_ROLE on all Bank Contracts.
# If absent, the watcher will log anomalies but skip automatic pausing.
PAUSER_KEY_PATH=

# ── Watcher RPC endpoints (optional JSON map: chain_id → URL) ─────────────────
# When set, the watcher uses these RPCs instead of RPC_URLS so it reads from
# different providers than the relayer, ensuring independent verification.
# Format: {"84532":"https://alternative-base-sepolia.example.com"}
# WATCHER_RPC_URLS={"84532":"https://alternative-base-sepolia.example.com"}

# ── Cold-path rebalancing ─────────────────────────────────────────────────────

# Minimum pool ratio (basis points, 0–10000) below which rebalancing triggers.
# Launch default: 8000 = 80% of equal-share target.
# COLD_PATH_MIN_BPS=8000

# Target pool ratio (basis points) to restore each chain to.
# 0 = equal distribution across all chains. Default: 0.
# COLD_PATH_TARGET_BPS=0

# Optional local maximum SyncUSD (in wei) that may be moved in a single planned
# operation. The source Bank contract's maxRebalanceAmount() is authoritative;
# Treasury reads it before submitting and splits larger operations sequentially.
# Expressed as a decimal string. Empty = no local cap. Default: no local cap.
# COLD_PATH_MAX_WEI=1000000000000000000000

# ETH (in wei) to include as msg.value in each rebalance tx to cover CCIP fees.
# Expressed as a decimal string. Default: 0 (no ETH sent).
# CCIP_FEE_WEI=10000000000000000

# Seconds between cold-path rebalance checks. Default: 60.
# COLD_PATH_POLL_SECS=60

# Stuck CCIP-message timeout for operator review. Initial runbook value: 30 minutes.
# COLD_PATH_STUCK_MESSAGE_TIMEOUT_SECS=1800
