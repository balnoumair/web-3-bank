# Treasury Service — environment variables
# Copy to .env and fill in values before running

# ── RPC endpoints (JSON map: chain_id → URL) ─────────────────────────────────
# Format: {"1":"https://mainnet.example.com","84532":"https://base-sepolia.example.com"}
RPC_URLS=

# ── Contract addresses (JSON map: chain_id → checksummed address) ─────────────
# Bank contract address per chain
# Format: {"84532":"0xYourContractAddress"}
CONTRACT_ADDRESSES=

# ── RouteReceiver address (Base Sepolia) ──────────────────────────────────────
ROUTE_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Relayer key ───────────────────────────────────────────────────────────────
# Path to a plaintext file containing the relayer's hex-encoded private key
RELAYER_KEY_PATH=

# ── Pauser key (optional) ─────────────────────────────────────────────────────
# Path to a plaintext file containing the pauser's hex-encoded private key.
# The account must hold PAUSER_ROLE on all Bank Contracts.
# If absent, the watcher will log anomalies but skip automatic pausing.
PAUSER_KEY_PATH=

# ── Watcher RPC endpoints (optional JSON map: chain_id → URL) ─────────────────
# When set, the watcher uses these RPCs instead of RPC_URLS so it reads from
# different providers than the relayer, ensuring independent verification.
# Format: {"84532":"https://alternative-base-sepolia.example.com"}
# WATCHER_RPC_URLS={"84532":"https://alternative-base-sepolia.example.com"}

# ── Cold-path rebalancing ─────────────────────────────────────────────────────

# Minimum pool ratio (basis points, 0–10000) below which rebalancing triggers.
# Launch default: 8000 = 80% of equal-share target.
# COLD_PATH_MIN_BPS=8000

# Target pool ratio (basis points) to restore each chain to.
# 0 = equal distribution across all chains. Default: 0.
# COLD_PATH_TARGET_BPS=0

# Optional local maximum SyncUSD (in wei) that may be moved in a single planned
# operation. The source Bank contract's maxRebalanceAmount() is authoritative;
# Treasury reads it before submitting and splits larger operations sequentially.
# Expressed as a decimal string. Empty = no local cap. Default: no local cap.
# COLD_PATH_MAX_WEI=1000000000000000000000

# ETH (in wei) to include as msg.value in each rebalance tx to cover CCIP fees.
# Expressed as a decimal string. Default: 0 (no ETH sent).
# CCIP_FEE_WEI=10000000000000000

# Seconds between cold-path rebalance checks. Default: 60.
# COLD_PATH_POLL_SECS=60

# ── User Service (optional) ───────────────────────────────────────────────────
# When set, treasury indexes `Deposited` events and calls `SetUserHomeChain`
# so first-deposit home routing is recorded. Example: 127.0.0.1:50051
# USER_SERVICE_ADDR=

# Stuck CCIP-message timeout for operator review. Initial runbook value: 30 minutes.
# COLD_PATH_STUCK_MESSAGE_TIMEOUT_SECS=1800

# ── Reserve-path rebalancing (USDC reserves via CCTP) ────────────────────────

# Minimum reserve ratio (basis points, 0–10000) below which a chain triggers a
# reserve bridge.  Spec default: 8000 = 80% of (total_reserve / num_active_chains).
# RESERVE_PATH_MIN_BPS=8000

# Optional per-op cap (USDC 6-decimal wei) for a single bridgeReserve call.
# Empty = no local cap (the Bank contract's maxReserveRebalanceAmount is authoritative).
# RESERVE_PATH_MAX_WEI=

# Seconds between reserve-path planning / relayer / watcher cycles. Default: 60.
# RESERVE_PATH_POLL_SECS=60

# Stuck-op timeout in seconds. Spec value for CCTP: 1800 (30 min).
# RESERVE_PATH_STUCK_TIMEOUT_SECS=1800

# JSON map: chain_id → CCTPReserveBridge adapter address (checksummed hex).
# Required for the relayer loop to dispatch `bridgeIn` on the destination chain.
# Format: {"84532":"0xYourBaseSepoliaAdapter","421614":"0xYourArbSepoliaAdapter"}
# RESERVE_BRIDGE_ADDRESSES=

# JSON map: chain_id → CCTP domain id (Ethereum=0, Avalanche=1, OP=2, Arbitrum=3,
# Base=6, Polygon=7, Solana=5, Noble=4, …). Required to query Circle's iris-api.
# Format: {"84532":6,"421614":3}
# CCTP_DOMAINS=

# Circle attestation API base URL.  Default: production endpoint.  Use
# `https://iris-api-sandbox.circle.com` for testnet.
# CIRCLE_ATTESTATION_API_URL=https://iris-api.circle.com

# Optional path to a separate private key for reserve-ops.  When unset, the cold-path
# RELAYER_KEY_PATH is reused.  Production SHOULD use a dedicated key (spec section 5).
# RESERVE_RELAYER_KEY_PATH=

# Wei to include as msg.value on bridgeIn calls (CCTP itself charges no receive fee).
# Default: 0.
# RESERVE_BRIDGE_FEE_WEI=0

# ── Reserve-accounting ledger reconciliation ─────────────────────────────────
# Internal double-entry mirror of USDC reserves (a cross-check, NOT the source
# of truth). The reconciliation loop compares each chain's ledger reserve
# balance against on-chain reserveDepth() and raises a watcher alert on drift.

# How often (seconds) to reconcile the ledger against on-chain reserveDepth().
# Reserves move rarely, so this need not be frequent. Default: 300 (5 minutes).
# RESERVE_RECON_POLL_SECS=300

# Allowed absolute gap (USDC 6-decimal wei, decimal string) between a chain's
# ledger reserve balance and its on-chain reserveDepth() before an alert fires.
# Absorbs lifecycle timing skew. Empty = 0 (exact match). Default: 0.
# RESERVE_RECON_TOLERANCE_WEI=
